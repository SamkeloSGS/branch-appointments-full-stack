# Copy to .env and set your Docker Hub user. Tags: latest (main), a version such as 1.2.3, or sha-<commit>.
BACKEND_IMAGE=samkelo1999/branch-appointments-backend:latest
FRONTEND_IMAGE=samkelo1999/branch-appointments-frontend:latest

# Everything below is optional: each line shows the default compose.yml uses. Uncomment a line to change it.

# --- Backend profile ---------------------------------------------------------------------------------------------
# local gives the backend its local settings and loads the sample catalog, hours and customers. Without it the
# backend runs as production and needs every BRANCH_*, address and URL below set.
# BACKEND_PROFILES=local
# DEPLOYMENT_ENVIRONMENT=local

# --- Host ports --------------------------------------------------------------------------------------------------
# The browser addresses below follow these. Keycloak's address is also built into the frontend image (its
# environment file), so after changing KEYCLOAK_PORT or KEYCLOAK_PUBLIC_URL the frontend needs an image built for it.
# FRONTEND_PORT=4200
# BACKEND_PORT=8081
# KEYCLOAK_PORT=8180
# MAILPIT_PORT=8025
# GRAFANA_PORT=3000

# --- Addresses the browser uses ----------------------------------------------------------------------------------
# FRONTEND_URL=http://localhost:4200
# KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Pages under the frontend, used in emails (default: built from FRONTEND_URL)
# MANAGE_URL=http://localhost:4200/appointments/{reference}
# SIGN_UP_URL=http://localhost:4200/sign-up
# STAFF_SETUP_REDIRECT_URL=http://localhost:4200/admin

# --- Addresses inside Docker -------------------------------------------------------------------------------------
# BACKEND_URL=http://backend:8081
# KEYCLOAK_URL=http://keycloak:8080/realms/appointments
# VAULT_URI=http://vault:8200
# DATABASE_URL=jdbc:postgresql://postgres:5432/appointments
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_SSL=false
# REDIS_MAX_MEMORY=128mb
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# OTLP_ENDPOINT=http://monitoring:4318

# --- Logins and secrets ------------------------------------------------------------------------------------------
# Seeded into Vault on every start (vault/init.sh); the database login also creates the PostgreSQL user. The
# database is created once: after changing its name or login, run docker compose down -v to start it afresh.
# DATABASE_NAME=appointments
# DATABASE_USERNAME=appointments
# DATABASE_PASSWORD=appointments
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# BACKEND_CLIENT_SECRET=local-dev-backend-secret
# WEBHOOK_SECRET_LOCAL=local-dev-webhook-secret
# Vault's dev-mode root token, and how the backend signs in to Vault
# VAULT_TOKEN=local-dev-root-token
# VAULT_AUTHENTICATION=TOKEN

# --- Sign-in and email -------------------------------------------------------------------------------------------
# Invited as branch manager at start-up while none exists
# FIRST_ADMIN_EMAIL=manager@appointments.test
# KEYCLOAK_ADMIN_ENABLED=true
# KEYCLOAK_SSL_REQUIRED=external
# KEYCLOAK_SMTP_AUTH=false
# NOTIFICATION_EMAIL_FROM=appointments@appointments.test
# KEYCLOAK_EMAIL_FROM=no-reply@appointments.test
# GRAFANA_EMAIL_FROM=grafana@appointments.test

# --- The branch --------------------------------------------------------------------------------------------------
# BRANCH_CODE=SANDTON
# BRANCH_NAME=Sandton City
# BRANCH_STREET=Sandton City, cnr Rivonia Road and 5th Street
# BRANCH_CITY=Sandton
# BRANCH_PROVINCE=Gauteng
# BRANCH_POSTAL_CODE=2196
# BRANCH_LATITUDE=-26.1076
# BRANCH_LONGITUDE=28.0567
# BRANCH_TIME_ZONE=Africa/Johannesburg
# Customers served: PERSONAL, BUSINESS or both
# BRANCH_SEGMENTS=PERSONAL,BUSINESS

# --- Monitoring, API docs and limits -----------------------------------------------------------------------------
# TRACING_SAMPLING_PROBABILITY=1.0
# API_DOCS_ENABLED=true
# RATE_LIMITS_ENABLED=true
